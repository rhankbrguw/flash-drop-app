# Example Environment Configuration
# Copy this file to .env and replace the values with your actual configuration.

# Server Port
PORT=8080

# PostgreSQL Connection String
DB_URL=postgres://postgres:password@localhost:5432/flashdrop?sslmode=disable

# Redis Connection String
REDIS_URL=redis://localhost:6379/0

# JWT Signing Secret (must match between auth-token generator and auth interceptor)
JWT_SECRET=supersecretjwtkeyflashdrop123

